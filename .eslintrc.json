{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": [
        "src/app/**/*.ts",
        "src/app/**/*.tsx",
        "src/lib/**/*.ts"
      ],
      "excludedFiles": [
        "src/lib/db.ts",
        "src/lib/db-tenant.ts",
        "src/lib/auth.ts",
        "src/lib/tenant.ts",
        "src/lib/rate-limit.ts",
        "src/lib/notifications.ts",
        "src/app/api/auth/**/*.ts",
        "src/app/api/developer/**/*.ts",
        "src/app/api/platform/**/*.ts",
        "src/app/api/tickets/**/*.ts",
        "src/app/api/tenant/onboarding/**/*.ts",
        "src/app/api/invites/accept/**/*.ts",
        "src/app/api/invites/redeem/**/*.ts",
        "src/app/api/invites/parent-link/**/*.ts",
        "src/app/platform-admin/**/*.tsx",
        "src/app/dashboard/platform/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/db", "*/lib/db", "../**/lib/db", "**/lib/db"],
                "message": "Use getTenantDb(centerId) instead of raw db for tenant routes. Raw db is only allowed with explicit inline disable."
              },
              {
                "group": ["@/lib/db-tenant", "*/lib/db-tenant", "../**/lib/db-tenant", "**/lib/db-tenant"],
                "message": "Do not import getTenantDb directly from db-tenant in app routes; use requireTenantAccess() and tenantCtx.getTenantDb() to enforce role and write-access gates."
              }
            ]
          }
        ],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "NewExpression[callee.name='PrismaClient']",
            "message": "Do not instantiate PrismaClient directly in API routes."
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx"
      ],
      "plugins": ["@typescript-eslint"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "error"
      }
    }
  ]
}
