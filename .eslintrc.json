{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": [
        "src/app/api/**/*.ts",
        "src/app/api/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/db", "*/lib/db", "../**/lib/db", "**/lib/db"],
                "message": "Use getTenantDb(centerId) instead of raw db for tenant routes. Raw db is only allowed with explicit inline disable."
              }
            ]
          }
        ],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "NewExpression[callee.name='PrismaClient']",
            "message": "Do not instantiate PrismaClient directly in API routes."
          }
        ]
      }
    }
  ]
}
