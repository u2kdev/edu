# База данных PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms?schema=public"
# Прямое подключение к PostgreSQL для миграций (Prisma migrate) в обход пулера соединений
DIRECT_URL="postgresql://postgres:password@localhost:5432/lms?schema=public"

# Безопасность и JWT (минимум 32 символа)
JWT_SECRET="replace-with-a-secure-random-32-char-secret-key!"

# Режим разработки
DEV_LOGIN=false
DEV_EMAIL_LOG=false

# Настройка доверенных прокси для определения IP клиента (getClientIp)
# 0 = по умолчанию: заголовки игнорируются, IP="unknown" (для прямого доступа без обратного прокси)
# 1 = один обратный прокси (Nginx, Traefik, Vercel, Railway, Render, AWS ALB)
# 2 = два уровня прокси (например, Cloudflare CDN -> Nginx)
TRUSTED_PROXY_HOPS=0

# Опционально: прямое доверие заголовкам Cloudflare (cf-connecting-ip) или Nginx (x-real-ip)
# TRUST_PROXY_HEADERS=false

# --- Приложение ---
# Публичный адрес приложения (обязателен в production; используется в ссылках из писем)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email ---
# memory | console | resend (в production обязателен resend)
EMAIL_PROVIDER="memory"
RESEND_API_KEY=""
EMAIL_FROM="e-darschi LMS <noreply@example.com>"

# --- Cron (защита /api/cron/*; в production минимум 16 символов) ---
CRON_SECRET="replace-with-a-random-16-char-secret"

# --- Загрузки файлов (S3 / Cloudflare R2) ---
FEATURE_UPLOADS="false"
# STORAGE_PROVIDER="s3" | "r2"
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
# Публичный домен CDN для отдачи файлов
STORAGE_PUBLIC_DOMAIN=""
# NEXT_PUBLIC_CDN_URL=""
