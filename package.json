    "eslint-config-next": "^14.2.15",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "prisma": "^5.21.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
