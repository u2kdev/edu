    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "2.15.4",
